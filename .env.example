# ==========================================
# OAIAW - APPLICATION
# ==========================================

APP_NAME=OAIAW
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql+psycopg://oaiaw_user:YOUR_PASSWORD@localhost:5432/oaiaw

DB_HOST=localhost
DB_PORT=5432
DB_NAME=oaiaw
DB_USER=oaiaw_user
DB_PASSWORD=YOUR_PASSWORD


# ==========================================
# AUTHENTICATION
# ==========================================

JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================
# AI / LLM
# ==========================================

LLM_PROVIDER=groq
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=YOUR_MODEL_NAME


# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://localhost:3000


# ==========================================
# ASSESSMENT
# ==========================================

ASSESSMENT_DEFAULT_DURATION_MINUTES=60
ASSESSMENT_MAX_DURATION_MINUTES=180


# ==========================================
# SANDBOX / EVALUATOR
# ==========================================

SANDBOX_ENABLED=true
SANDBOX_NETWORK_ENABLED=false
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_TIMEOUT_SECONDS=30


# ==========================================
# AI CONTEXT LIMITS
# ==========================================

AI_MAX_CONTEXT_FILES=20
AI_MAX_FILE_SIZE_KB=500
AI_MAX_SEARCH_RESULTS=50
AI_MAX_CONTEXT_TOKENS=16000


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
